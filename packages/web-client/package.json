{
  "name": "@assistant/web-client",
  "version": "0.18.2",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "npm run fonts:bundle && esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=public/client.js && npm run bundle:plugins",
    "fonts:bundle": "node scripts/bundle-fonts.mjs",
    "bundle:plugins": "node -e \"console.log('No web-client plugins to bundle.');\""
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/cascadia-code": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@types/dompurify": "^3.0.5",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@assistant/shared": "*",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "partial-json": "^0.1.7"
  },
  "optionalDependencies": {
    "@capacitor/push-notifications": "8.0.0",
    "@capgo/capacitor-share-target": "8.0.2"
  }
}
